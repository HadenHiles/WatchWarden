# WatchWarden environment template
# Copy to .env, replace every demo secret, and never commit the resulting file.
# Integration values can be entered in onboarding instead; environment values
# are useful as deployment-level fallbacks.

# Runtime
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
NEXT_PUBLIC_APP_NAME=WatchWarden

# Database (Compose constructs DATABASE_URL for containers from this password)
POSTGRES_PASSWORD=demo_replace_with_a_long_random_database_password
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgresql://watchwarden:demo_replace_with_a_long_random_database_password@localhost:5435/watchwarden

# Authentication and internal API communication
SESSION_SECRET=demo_replace_with_at_least_32_random_characters
API_SECRET=demo_replace_with_at_least_16_random_characters
ADMIN_USERNAME=admin
# Optional legacy fallback only; onboarding creates the real database-backed admin.
# Generate with: node -e "require('bcryptjs').hash(process.argv[1],12).then(console.log)" 'your-password'
ADMIN_PASSWORD_HASH=$2a$12$k.s9xneegzdTGzbkhsQQqeQUISf8KqCfuIM6axc3zDwKR71Mvgwn.

# URLs
NEXTAUTH_URL=https://watchwarden.example.com
API_URL=http://api:4000
NEXT_PUBLIC_API_URL=https://watchwarden.example.com
NEXT_PUBLIC_JELLYSEERR_URL=https://requests.example.com

# Optional deployment/update metadata
DOCKER_UPDATE_IMAGE=example/watchwarden

# Optional integration fallbacks (prefer onboarding for normal installations)
PLEX_BASE_URL=http://plex:32400
PLEX_TOKEN=demo_plex_token
TAUTULLI_BASE_URL=http://tautulli:8181
TAUTULLI_API_KEY=demo_tautulli_api_key
JELLYSEERR_BASE_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=demo_jellyseerr_api_key
JELLYSEERR_BOT_USER_ID=2
TMDB_API_KEY=demo_tmdb_api_key
TRAKT_CLIENT_ID=demo_trakt_client_id

# Background schedules (standard five-field cron expressions)
TREND_SYNC_CRON=0 */6 * * *
TAUTULLI_SYNC_CRON=0 */2 * * *
SCORING_CRON=30 */6 * * *
JELLYSEERR_STATUS_SYNC_CRON=0 * * * *
JELLYSEERR_DISCOVER_SYNC_CRON=0 */6 * * *
LIBRARY_SYNC_CRON=0 */3 * * *
LIFECYCLE_EVAL_CRON=0 4 * * *
EXPORT_CRON=15 */6 * * *
PLEX_SYNC_CRON=45 */6 * * *
EXPORT_OUTPUT_DIR=/app/exports
